# ─────────────────────────────────────────────────
# Second Brain — Environment Variables
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────

# PostgreSQL connection string.
# Neon (recommended): https://neon.tech — free tier available
# Supabase: https://supabase.com — also has a generous free tier
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/second_brain"

# Google Gemini API key for AI features (summarization, auto-tagging, chat).
# Get one at: https://aistudio.google.com/apikey
# The app works without this — AI features just degrade gracefully.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Base URL for the app (used for public API CORS and metadata).
# In development, this is usually http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
